*.py[cod]
*.egg-info/
.DS_Store
dist/
build/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Build tenant working state — trace surface, not committed
build_tenants/*/*/.workspace/iterations/
build_tenants/*/*/.workspace/manifests/
build_tenants/*/*/.workspace/working_surfaces/

# Legacy build working state — trace surface, not committed
builds/*/.workspace/iterations/
builds/*/.workspace/manifests/
builds/*/.workspace/working_surfaces/

# Installed engine — created by gen-install.py, not committed
.genesis/

# Local env
.env
.venv/
venv/

# Engine runtime artifacts

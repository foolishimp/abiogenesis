{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abg.schema.product-toolchain-manifest@5",
  "title": "ABIogenesis Product Toolchain Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "productId",
    "packageName",
    "packageVersion",
    "productContentDigest",
    "productRelativeLocators",
    "descriptorRef",
    "publisherNamespace",
    "contributionManifestRef",
    "compatibilityRefs",
    "declaredDependencies",
    "provenanceRef",
    "declaredCapabilityRefs",
    "publicContractCatalog"
  ],
  "properties": {
    "kind": {
      "const": "abg_product_toolchain_manifest"
    },
    "schemaVersion": {
      "const": "5.0.0"
    },
    "productId": {
      "type": "string",
      "minLength": 1
    },
    "packageName": {
      "type": "string",
      "minLength": 1
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "productContentDigest": {
      "$ref": "#/$defs/sha256"
    },
    "productRelativeLocators": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "descriptorRef": {
      "$ref": "#/$defs/ref"
    },
    "publisherNamespace": {
      "$ref": "#/$defs/ref"
    },
    "contributionManifestRef": {
      "$ref": "#/$defs/ref"
    },
    "compatibilityRefs": {
      "$ref": "#/$defs/refs"
    },
    "declaredDependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "provenanceRef": {
      "$ref": "#/$defs/ref"
    },
    "declaredCapabilityRefs": {
      "$ref": "#/$defs/refs"
    },
    "publicContractCatalog": {
      "type": "object"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ref": {
      "type": "string",
      "pattern": "\\S"
    },
    "refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "productId",
        "packageVersion",
        "compatibilityRef",
        "requiredContractRefs",
        "requiredCapabilityRefs"
      ],
      "properties": {
        "kind": {
          "const": "requires"
        },
        "productId": {
          "$ref": "#/$defs/ref"
        },
        "packageVersion": {
          "$ref": "#/$defs/ref"
        },
        "compatibilityRef": {
          "$ref": "#/$defs/ref"
        },
        "requiredContractRefs": {
          "$ref": "#/$defs/refs"
        },
        "requiredCapabilityRefs": {
          "$ref": "#/$defs/refs"
        }
      }
    }
  }
}

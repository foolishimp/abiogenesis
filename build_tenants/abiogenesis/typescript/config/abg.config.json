{
  "kind": "abg_config_bundle",
  "version": 1,
  "levers": {
    "kind": "abg_lever_overrides_bundle",
    "abgDefaultsFamily": "abg_defaults",
    "version": 1,
    "bundleRef": "lever-overrides://abg/typescript",
    "overrides": {
      "abg.m04.until": "converged",
      "abg.m04.fh_mode": "direct",
      "abg.runner.retry.max_attempts": 10
    }
  },
  "fallbacks": {
    "kind": "abg_fallback_bundle",
    "abgDefaultsFamily": "abg_defaults",
    "version": 1,
    "bundleRef": "fallback-bundle://abg/reference/typescript",
    "pluginTraversalObserverBindings": {
      "transform": {
        "absenceLawful": true,
        "observerPromptRef": "prompt://abg/reference/generic-transform-observer",
        "promptTemplateRef": "template://abg/reference/generic-transform-observer",
        "promptInputContractRef": "contract://abg/plugin-traversal/transform-input",
        "expectedOutputContractRef": "contract://abg/plugin-traversal/transform-output",
        "continuationRequestRefs": [
          "continuation://abg/drive-transform-forward"
        ],
        "progressSignalRefs": [
          "progress://abg/stream-observed",
          "progress://abg/artifact-candidate-observed"
        ],
        "policyRefs": [
          "policy://abg/reference/defaults/plugin-traversal-observer"
        ]
      },
      "evaluate": {
        "absenceLawful": true,
        "observerPromptRef": "prompt://abg/reference/generic-evaluate-observer",
        "promptTemplateRef": "template://abg/reference/generic-evaluate-observer",
        "promptInputContractRef": "contract://abg/plugin-traversal/evaluate-input",
        "expectedOutputContractRef": "contract://abg/plugin-traversal/evaluate-output",
        "continuationRequestRefs": [
          "continuation://abg/continue-evaluation"
        ],
        "progressSignalRefs": [
          "progress://abg/evaluation-observed"
        ],
        "policyRefs": [
          "policy://abg/reference/defaults/plugin-traversal-observer"
        ]
      },
      "consequence": {
        "absenceLawful": true,
        "observerPromptRef": "prompt://abg/reference/generic-consequence-observer",
        "promptTemplateRef": "template://abg/reference/generic-consequence-observer",
        "promptInputContractRef": "contract://abg/plugin-traversal/consequence-input",
        "expectedOutputContractRef": "contract://abg/plugin-traversal/consequence-output",
        "continuationRequestRefs": [
          "continuation://abg/project-consequence"
        ],
        "progressSignalRefs": [
          "progress://abg/consequence-observed"
        ],
        "policyRefs": [
          "policy://abg/reference/defaults/plugin-traversal-observer"
        ]
      }
    }
  },
  "targetCarriers": {
    "kind": "gtl_target_carrier_defaults_bundle",
    "gtlDefaultsFamily": "gtl_defaults",
    "version": 1,
    "bundleRef": "defaults-bundle://gtl/reference/target-carriers",
    "genericOutputTemplate": {
      "templateRef": "gtl://target-carrier-template/generic-output",
      "hookRefTemplate": "gtl-defaults:{templateRef}:{targetNodeRef}",
      "contractRefTemplate": "gtl://target-carrier-contract/generic-output:{targetNodeRef}",
      "outputSurfaceRefTemplate": "asset-type://abiogenesis/{outputCarrierKind}",
      "outputCarrierFamilyRef": "gtl://target-carrier-family/generic",
      "outputCarrierKindSource": "target_asset_surface_kind_or_name",
      "envelopeContractRef": "gtl://target-carrier-envelope/generic",
      "nestedPayloadPath": "payload",
      "requiredFieldRefs": [
        "kind",
        "targetAssetType",
        "edgeRef",
        "contractRef",
        "contractDigest",
        "payload"
      ],
      "optionalFieldRefs": [],
      "fixedProtocolFieldRefs": [
        "kind",
        "targetAssetType",
        "edgeRef",
        "contractRef",
        "contractDigest"
      ],
      "workerFillableFieldRefs": [
        "payload"
      ],
      "literalDomainRefTemplates": [
        "kind:{outputCarrierKind}",
        "targetAssetType:{outputCarrierKind}"
      ],
      "enumDomainRefs": [],
      "schemaRefSource": "target_schema_ref",
      "admissionRef": "admission://abg/target-carrier/generic",
      "payloadLedgerBindingRef": "payload-ledger://abg/target-carrier",
      "edgeAssuranceBindingRef": "edge-assurance://abg/target-carrier",
      "handoffProjectionRef": "handoff-projection://abg/target-carrier/generic",
      "constructionTemplateRef": "construction-template://gtl/target-carrier/generic-output",
      "replayDigestPolicyRef": "replay-digest://abg/target-carrier",
      "materializationPolicyRef": "materialization://gtl/target-carrier",
      "closurePreconditionRef": "closure-precondition://abg/target-carrier-admitted",
      "testCaseGenerationRef": "gtl://test-case-generation/target-carrier"
    }
  }
}

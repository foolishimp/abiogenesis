    "test:t026": "npm run build:semantic && node --test test_env/tests/t026-m03-transport-protocol-negative.test.mjs test_env/tests/test_m03_transport_protocol_unit.test.mjs test_env/tests/test_m03_transport_protocol_integration.test.mjs",

    "test:t011": "npm run build:semantic && node --test test_env/tests/t011-abg-negative-ingress.test.mjs test_env/tests/test_m03_engine_kernel_integration.test.mjs",
    "test:t012": "npm run build:semantic && node --test test_env/tests/t012-m04-negative-ingress.test.mjs test_env/tests/test_m04_app_bootstrap_unit.test.mjs test_env/tests/test_m04_app_bootstrap_integration.test.mjs",
    "test:t013": "npm run build:semantic && node --test test_env/tests/t013-m04-control-negative.test.mjs test_env/tests/test_m04_control_loop_unit.test.mjs test_env/tests/test_m04_control_loop_integration.test.mjs",

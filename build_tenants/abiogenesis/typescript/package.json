    "test:m5:workflow": "npm run build && node --test --test-concurrency=1 test_env/tests/m5-installed-workflow.test.mjs",
    "test:m5:retry": "npm run build && node --test --test-concurrency=1 test_env/tests/m5-installed-retry.test.mjs",
    "test:m5:fibre": "npm run build && node --test --test-concurrency=1 test_env/tests/m5-fibre-substitution.test.mjs",
    "test:m5:conservation": "npm run build && node --test --test-concurrency=1 test_env/tests/m5-c-algebra-validation.test.mjs test_env/tests/m5-traversal-conservation.test.mjs",
    "test:m5": "npm run build && node --test --test-concurrency=1 test_env/tests/m5-c-algebra-validation.test.mjs test_env/tests/m5-direct-hog-fold.test.mjs test_env/tests/m5-installed-compose.test.mjs test_env/tests/m5-installed-graph-edge.test.mjs test_env/tests/m5-installed-substitute.test.mjs test_env/tests/m5-worker-transport.test.mjs test_env/tests/m5-installed-fp.test.mjs test_env/tests/m5-installed-workflow.test.mjs test_env/tests/m5-installed-retry.test.mjs test_env/tests/m5-fibre-substitution.test.mjs test_env/tests/m5-installed-fp-fd-compose.test.mjs"

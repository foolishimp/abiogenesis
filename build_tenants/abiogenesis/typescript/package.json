    "test:t017": "npm run build:semantic && node --test test_env/tests/t017-m04-result-assessment-negative.test.mjs test_env/tests/test_m04_result_assessment_unit.test.mjs test_env/tests/test_m04_result_assessment_integration.test.mjs",
    "test:t018": "npm run build:semantic && node --test test_env/tests/t018-m04-live-status-negative.test.mjs test_env/tests/test_m04_live_status_unit.test.mjs test_env/tests/test_m04_live_status_integration.test.mjs",

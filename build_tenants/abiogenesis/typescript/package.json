    "test:t045": "npm run build:semantic && node --test test_env/tests/t045-m03-retry-leaftask-negative.test.mjs test_env/tests/test_m03_retry_repair_unit.test.mjs test_env/tests/test_m03_leaf_task_integration.test.mjs",
    "test:t030": "npm run build:semantic && node --test test_env/tests/t030-m05-archive-finalization-negative.test.mjs test_env/tests/test_m05_archive_finalization_unit.test.mjs test_env/tests/test_m05_run_archive_integration.test.mjs",

{
  "name": "@abiogenesis/typescript-tenant",
  "version": "5.0.0-dev.286",
  "description": "ABIogenesis 5 direct-GTL TypeScript product",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "abg.cli": "./build/code/src/public/cli.js"
  },
  "exports": {
    ".": {
      "types": "./build/code/src/index.d.ts",
      "import": "./build/code/src/index.js"
    },
    "./product": {
      "types": "./build/code/src/product/index.d.ts",
      "import": "./build/code/src/product/index.js"
    },
    "./abg": {
      "types": "./build/code/src/abg/index.d.ts",
      "import": "./build/code/src/abg/index.js"
    },
    "./gtl": {
      "types": "./build/code/src/gtl/index.d.ts",
      "import": "./build/code/src/gtl/index.js"
    },
    "./hog": {
      "types": "./build/code/src/hog/index.d.ts",
      "import": "./build/code/src/hog/index.js"
    },
    "./public": {
      "types": "./build/code/src/public/index.d.ts",
      "import": "./build/code/src/public/index.js"
    },
    "./validator": {
      "types": "./build/code/src/validator/index.d.ts",
      "import": "./build/code/src/validator/index.js"
    }
  },
  "files": [
    "build/**",
    "contracts/**",
    "product-toolchain-manifest.json"
  ],

    "test:t021": "npm run build:semantic && node --test test_env/tests/t021-m05-qualification-negative.test.mjs test_env/tests/test_m05_method_trace_unit.test.mjs test_env/tests/test_m05_fake_lane_integration.test.mjs",
    "test:t022": "npm run build:semantic && node --test test_env/tests/t022-m05-installed-sandbox-negative.test.mjs test_env/tests/test_m05_sandbox_install_integration.test.mjs test_env/tests/test_m05_sandbox_live_integration.test.mjs test_env/tests/test_m05_installed_graph_function_target_integration.test.mjs test_env/tests/test_m05_run_archive_integration.test.mjs",

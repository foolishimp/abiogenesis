#!/usr/bin/env node

import { appendFileSync } from "node:fs";

const callLog = process.env["T223_FP_CALL_LOG"];
if (callLog === undefined || callLog.length === 0) {
  process.stderr.write("T223_FP_CALL_LOG is required\n");
  process.exitCode = 2;
} else {
  appendFileSync(callLog, "called\n", "utf8");
  const prompt = process.argv[2] ?? "";
  const evaluate = prompt.includes("Run evaluate");
  const marker = evaluate
    ? "Set resultContractRef to "
    : "Set result_contract_ref to ";
  const contractLine = prompt
    .split("\n")
    .find((line) => line.startsWith(marker));
  if (contractLine === undefined || !contractLine.endsWith(".")) {
    throw new TypeError("prompt does not carry one selected result contract");
  }
  const resultContractRef = JSON.parse(
    contractLine.slice(marker.length, -1)
  );
  const output = evaluate
    ? {
        resultContractRef,
        accepted: true,
        closeDisposition: "close",
        assessmentIds: [],
        reasons: []
      }
    : {
        result_contract_ref: resultContractRef,
        edge: "hello-input-to-output",
        actor: "t223-packed-fake-agent",
        fulfillment_assessments: [
          {
            id: "instruction_response_admitted",
            evaluator: "instruction_response_admitted",
            fulfillment_status: "fulfilled",
            fulfillment_detail: "packed fake transport admitted",
            blocking_reasons: [],
            evidence_refs: ["evidence://t223/packed-fake-transport"]
          }
        ],
        target_value: { message: "Hello, world!" }
      };
  process.stdout.write(JSON.stringify(output));
}

#!/usr/bin/env node

import { appendFileSync } from "node:fs";

const callLog = process.env["T223_FP_CALL_LOG"];
if (callLog === undefined || callLog.length === 0) {
  process.stderr.write("T223_FP_CALL_LOG is required\n");
  process.exitCode = 2;
} else {
  appendFileSync(callLog, "called\n", "utf8");
  const prompt = process.argv[2] ?? "";
  const output = prompt.includes("Run evaluate")
    ? {
        accepted: true,
        assessmentIds: []
      }
    : {
        edge: "hello-input-to-output",
        actor: "t223-packed-fake-agent",
        message: "Hello, world!",
        fulfillment_assessments: [
          {
            id: "instruction_response_admitted",
            evaluator: "instruction_response_admitted",
            fulfillment_status: "fulfilled",
            fulfillment_detail: "packed fake transport admitted",
            blocking_reasons: [],
            evidence_refs: ["evidence://t223/packed-fake-transport"]
          }
        ]
      };
  process.stdout.write(JSON.stringify(output));
}

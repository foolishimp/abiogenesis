#!/usr/bin/env node

const { appendFileSync } = require("node:fs");

const prompt = process.argv[2] ?? "";
const submitterTurn = prompt.includes(
  "You are the declared submitter in an ABIogenesis Consensus GraphFunction."
);
const profile = submitterTurn
  ? /Submitter worker ref: ([^\n]+)/u.exec(prompt)?.[1] ?? "unknown"
  : /Reviewer profile ref: ([^\n]+)/u.exec(prompt)?.[1] ?? "unknown";
const subject = /Subject ref: ([^\n]+)/u.exec(prompt)?.[1] ?? "unknown";
const round = Number.parseInt(/Round: (\d+)/u.exec(prompt)?.[1] ?? "1", 10);
const hasPriorSubmitterResponse = prompt.includes(
  '"kind":"consensus_submitter_response"'
);
const callLog = process.env["A5_CONSENSUS_CALL_LOG"];

if (callLog !== undefined && callLog.length > 0) {
  appendFileSync(
    callLog,
    `${JSON.stringify({
      hasPriorSubmitterResponse,
      profile,
      role: submitterTurn ? "submitter" : "reviewer",
      round,
      subject
    })}\n`,
    "utf8"
  );
}

if (submitterTurn) {
  const decisionText =
    /Disputed round decision: ([^\n]+)/u.exec(prompt)?.[1];
  if (decisionText === undefined) {
    process.stdout.write("missing-decision");
    process.exit(0);
  }
  const decision = JSON.parse(decisionText);
  process.stdout.write(
    JSON.stringify({
      kind: "consensus_submitter_payload",
      decisionRef: decision.decisionRef,
      summary: "Submitter addresses every admitted dissent finding.",
      addressedFindingRefs: decision.dissentFindingRefs,
      evidenceRefs: ["evidence://a5/submitter/response"]
    })
  );
  process.exit(0);
}

if (subject.includes("malformed") && profile.includes("claude")) {
  process.stdout.write("not-json");
  process.exit(0);
}

const disputed = subject.includes("dispute") || subject.includes("escalate");
if (disputed && round > 1 && !hasPriorSubmitterResponse) {
  process.stdout.write("missing-admitted-submitter-foldback");
  process.exit(0);
}
const objection = disputed && round === 1 && profile.includes("codex");
const encodedProfile = encodeURIComponent(profile);
const payload = {
  kind: "consensus_reviewer_payload",
  disposition: objection ? "revise" : "accept",
  findings: [
    {
      kind: "consensus_reviewer_finding",
      findingRef: `finding://a5/${encodedProfile}/round-${String(round)}`,
      claimRef: "claim://a5/shared-release-claim",
      findingKind: objection ? "objection" : "support",
      summary: objection ? "fixture objection" : "fixture support",
      evidenceRefs: [
        `evidence://a5/${encodedProfile}/round-${String(round)}`
      ]
    }
  ],
  ruling: {
    kind: "consensus_ruling_proposal",
    rulingKind: "decision_row",
    summary: objection
      ? "fixture proposes revision"
      : "fixture proposes admission",
    evidenceRefs: [`evidence://a5/ruling/${encodedProfile}`]
  },
  evidenceRefs: [`evidence://a5/response/${encodedProfile}`]
};

process.stdout.write(JSON.stringify(payload));

{
  "kind": "sdlc_tenant_technology_stack_description",
  "language": "Rust",
  "buildTool": "cargo",
  "crateType": "binary",
  "buildConfigTargets": [
    "Cargo.toml"
  ],
  "executionEnvironment": {
    "hostCachePolicy": "prohibited",
    "workspaceLocalDirectories": [
      "target/"
    ],
    "environmentVariables": {
      "HELLO_SERVICE_PORT": "${HELLO_SERVICE_PORT:-18182}"
    },
    "byproductRules": [
      "Cargo.lock",
      "target/"
    ]
  },
  "byproductRules": [
    "Cargo.lock",
    "target/"
  ],
  "testingTechStack": {
    "testMode": "local_http_service_smoke",
    "testRunner": "curl",
    "testRoots": [
      "tests/"
    ],
    "testBuildConfigTargets": [
      "Cargo.toml"
    ],
    "evidenceFormat": "process-exit-plus-http-response",
    "byproductRules": [
      "Cargo.lock",
      "target/"
    ]
  },
  "dependencyPolicy": "no_external_runtime_crates",
  "runtime": {
    "bindAddress": "127.0.0.1",
    "portEnvVar": "HELLO_SERVICE_PORT"
  }
}

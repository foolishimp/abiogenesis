cusRef":"node://abiogenesis/qualification/assess@5","role":{"actorRef":"actor://abiogenesis/qualification/assessor-primary@5","authorityRef":"actor-capability://abiogenesis/qualification/product-owner@5","independence":"author_distinct","materializationPlanRef":"materialization-plan://abiogenesis/qualification/assessment@5","rendererRef":"renderer://abiogenesis/qualification/assessment@5","roleRef":"qualification-role://abiogenesis/rule@5","sourceBindings":[{"byteCount":6687,"digest":"sha256:4fa6ea8b7d655a395916b135e333e5f96a5bb309c9166c3e41d14c67d2e21f61","path":"contracts/qualification/sources/REQ-P-SELF-CONFORMANCE.md","ref":"repo://abiogenesis/specification/requirements/product/REQ-P-SELF-CONFORMANCE.md"},{"byteCount":35509,"digest":"sha256:9ec53d8053fcae9780ad0d161c0b3fe605523319965b59d5653865254bac1831","path":"contracts/qualification/sources/REQ-P-QUAL.md","ref":"repo://abiogenesis/specification/requirements/product/REQ-P-QUAL.md"}],"workerBindingRef":"worker-binding://abiogenesis/qualification/assessor@5"},"slotRef":"slot://abiogenesis/t287/genuine-context-assessment-04","task":{"digest":"sha256:f14f55c83c78c61457176a452d1a655c3b3abc899b02500d027b72e8a72eb650","ref":"qualification-task://abiogenesis/f14f55c83c78c61457176a452d1a655c3b3abc899b02500d027b72e8a72eb650"},"taskOrdinal":0}],"subjectBasis":{"digest":"sha256:8864ae55e65b766b4cedd327cced21795399d25bcb7535b45cae4ea197f50383","ref":"qualification-basis://abiogenesis/8864ae55e65b766b4cedd327cced21795399d25bcb7535b45cae4ea197f50383"}},"raw":{"attributions":[{"activationRef":"file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_REFERENCE_ATTRIBUTION_REPAIR_01/source-construction/activation.json","actorIdentityRef":"actor://codex/root/public_preparation_worker","authorRef":"actor://codex/root/public_preparation_worker","authorityRef":"actor-capability://abiogenesis/qualification/product-owner@5","disposition":"established","reason":"The activation and the closure both name actor://codex/root/public_preparation_worker as author and actor. The activation's grant digest (9a16ea85...) matches the supplied grant.md. The grant authorizes exactly the repair in the delta: an optional resolved-provenance parameter, passed from projectQualificationConstructionAuthors. It names the proof.ts preimage as 82284B/b928caef. The preimage manifest lists the same b928/82284, and the supplied preimage body contains projectExternalConstructionAttribution(judgment, plan). The delta hunk adds ', provenance' (+12B), giving 82296B, which matches the closure entry and the current 9b6b1ec6 member; the current body contains the edited call. The historical two-file scope is kept unrewritten, and the current chain selects only proof.ts, as grant04 describes. The assessor (assessor-primary@5) is distinct from the author. Authority: the record names the file grant issued under the owner's 'start'. product-owner@5 is the policy authority slot under grant04's correspondence, with no retroauthorization. I take this as sufficient within the trusted-desktop boundary. SHA-256 digests were not independently recomputed.","scopeRefs":["file:///Users/jim/src/apps/abiogenesis/build_tenants/abiogenesis/typescript/code/src/abg/qualification_proof.ts"],"sourceRefs":["file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_REFERENCE_ATTRIBUTION_REPAIR_01/source-construction/activation.json","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_REFERENCE_ATTRIBUTION_REPAIR_01/source-construction/preimage.json","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_REFERENCE_ATTRIBUTION_REPAIR_01/source-construction/delta.patch","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_REFERENCE_ATTRIBUTION_REPAIR_01/source-construction/closure.json","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_REFERENCE_ATTRIBUTION_REPAIR_01/source-construction/preimages/qualification_proof.ts","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/work/T287_REFERENCE_ATTRIBUTION_REPAIR_01/grant.md","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/work/T287_GENUINE_CONTEXT_ASSESSMENT_04/grant.md","file:///Users/jim/src/apps/abiogenesis/build_tenants/abiogenesis/typescript/code/src/abg/qualification_proof.ts"]},{"activationRef":"file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_CONTEXT_PROJECTION_REPAIR_01/source-construction/activation.json","actorIdentityRef":"actor://codex/root/public_preparation_worker","authorRef":"actor://codex/root/public_preparation_worker","authorityRef":"actor-capability://abiogenesis/qualification/product-owner@5","disposition":"established","reason":"The activation's grant digest (42993387...) matches the supplied grant. The grant names the author, actor://codex/root/public_preparation_worker, and the qualification.ts territory with preimage 63484B/8f92906d. This is the intermediate postimage recorded in the reference-attribution closure (63360+124=63484). The activation and closure name the same author and actor, and the preimage manifest lists 8f929/63484. The delta removes 'if (task.scope !== undefined) ' (30B) from material validation and the ungrouped ternary (42B) from the attribution rendering. That gives 63412B, which matches the closure's 0ee4bc36 entry; the current body shows both edits. Per the grant, proof.ts stays at 9b6b1ec6. The activation scope is qualification.ts only, which matches this chain. The assessor is distinct from the author. Authority is the file grant issued under the owner's 'start', mapped by grant04 to the product-owner@5 policy slot with no retroauthorization. I take this as sufficient within the trusted-desktop boundary. SHA-256 digests were not independently recomputed.","scopeRefs":["file:///Users/jim/src/apps/abiogenesis/build_tenants/abiogenesis/typescript/code/src/validator/qualification.ts"],"sourceRefs":["file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_CONTEXT_PROJECTION_REPAIR_01/source-construction/activation.json","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_CONTEXT_PROJECTION_REPAIR_01/source-construction/preimage.json","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_CONTEXT_PROJECTION_REPAIR_01/source-construction/delta.patch","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_CONTEXT_PROJECTION_REPAIR_01/source-construction/closure.json","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_CONTEXT_PROJECTION_REPAIR_01/source-construction/preimages/qualification.ts","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/work/T287_CONTEXT_PROJECTION_REPAIR_01/grant.md","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/work/T287_GENUINE_CONTEXT_ASSESSMENT_04/grant.md","file:///Users/jim/src/apps/abiogenesis/build_tenants/abiogenesis/typescript/code/src/validator/qualification.ts"]}],"criteria":[{"applicability":"applicable","criterionRef":"criterion://abiogenesis/t287/genuine-context-assessment-04/007A","disposition":"falsified","evidenceRefs":["file:///Users/jim/src/apps/abiogenesis/.ai-workspace/work/T287_CONTEXT_PROJECTION_REPAIR_01/focused.stdout","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/work/T287_CONTEXT_PROJECTION_PACKAGE_02/packed.stdout","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_CONTEXT_PROJECTION_PACKAGE_02/acceptance.json","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/work/T287_CONTEXT_CONSERVATION_02/flow-observation.json","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/work/T287_CONTEXT_CONSERVATION_02/fresh/cold-read-observation.json","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_CONTEXT_CONSERVATION_02/acceptance.json"],"evidenceRole":"semantic_assessment","reason":"APPLICABILITY: REQ-P-SELF-CONFORMANCE-007A says the admitted complete F11 result must conserve subject/law, behavioral coverage, execution evidence and independent applicability/sufficiency judgment. It must feed the sole AF22 without reinterpreting release qualification, and missing coverage must stay blocked. qualification_proof.ts is the native proof owner that supplies F11 its authenticated inputs (D4/D5 HOW section 3; reusable target section 2). Its relevant functions are resolveQualificationAssessments, projectQualificationJudgment, projectQualificationConstructionAuthors, resolveQualificationExecutionMaterial and projectQualificationSelfConformance.\n\nWHAT HOLDS: (1) The reference-attribution repair is present and correct. projectQualificationConstructionAuthors resolves the provenance through the canonical resource owner and passes it as the third argument to projectExternalConstructionAttribution. Embedded callers still default to judgment.task.provenance. The original J/task/plan bytes are unchanged, and every record, digest, patch, postimage, scope, span, authority and attribution guard remains. Author/assessor independence is still checked. This removes the native04 trigger, where a qualification_resource_selection was read as provenance, judged invalid, and produced authors=null. (2) projectQualificationSelfConformance checks one unique F11 producer and the same subjectBasis/lawBasis. It maps passed/failed/other to green/red/blocked and cites the F11 Result coordinate. F11 keeps qualificationVerdict:false. reduceExactCandidateQualification keeps red/blocked and blocks a non-ready basis, any bypass, and verification that has not passed. soleDeclaredReducer and the peer checks keep AF22 single. (3) Execution material keeps the original Result, judgment, evidence and origin, with unique producers and installed-subject checks; shared evidence may support several claims. (4) The controlled02 evidence shows a one-slot plan where falsified J A keeps its citation, B outside the plan is J_required, F11 fails, AF22 is red citing the F11 Result, and fresh reads preserve the producers. This prompt also shows the context projection working: construction records appear as metadata plus spans, and their bodies appear once, as SOURCE DATA.\n\nFALSIFYING DEFECT: resolveQualificationAssessments still treats the plan slots as all-or-nothing. Inside the slot loop it returns null for the whole plan in any of these cases: a missing or duplicate judgment_selection (selections.length !== 1), any refused J projection, null construction authors, or an independence violation. self_conformance.ts then sets assessment to null. Every J-dependent finding becomes blocked_incomplete/J_required, and no authenticated J survives, including an admitted falsified J and its citation. The reference-attribution grant's own triage named this mechanism: 'authors=null at resolver discards all J before correct aggregation'. Its repair removed one trigger and explicitly excluded changes to the aggregation rule. Slot keys and plan identity are fixed before execution, and each J input binds the plan. So a declared peer that produces no J (a transport failure creates no judgment, carrier HOW section 5) cannot be dropped without invalidating the other slots' J. The accepted design requires per-slot conservation: reusable target section 5 ('Known falsification and its citations survive missing peers; remaining incompleteness stays explicit') and section 8 QO5, plus D4/D5 HOW ('their finite coverage and independence obligations remain separate'; missing attribution 'blocks the dependent claim'). The outcome stays non-green, so there is no false green. But a known red is degraded to blocked, and admitted independent judgment is not conserved, contrary to 007A and QUAL-064C's conservation of explicit red/blocked. Controlled02 avoided this path by placing B outside the plan, so no evidence exercises a missing or refused peer slot inside a plan.","residuals":["Defect to fix: resolveQualificationAssessments returns null for the whole plan when any single slot fails (missing selection, refused J, null authors, independence violation). This must be fixed at the native proof/F11 aggregation join, which needs an aggregation-scope grant. The fix should keep each authenticated J, record missing or refused slots as explicit incompleteness, and keep a known falsification red.","No evidence covers a plan with an authentic falsified J plus a missing or refused peer slot. Controlled02 placed B outside the finite plan.","projectQualificationSelfConformance builds bypassRefs only from the evidenceRefs of accepted_reentry findings. A finding with no evidenceRefs would lose its bypass identity (the disposition still stays blocked), and duplicate refs would make the verdict input refuse. The current evaluator never emits accepted_reentry, so this path is untested.","Parent/child alias, grouped/scoped, F_H acknowledgment and genuine Phase2 F11/fresh-read paths have no current evidence."],"ruleRef":"rule://abiogenesis/self-conformance/5479c7c8062549b2353ba65cb38a14dcc3f0f2e1184dbbd042fad53a97558fca@2","sourceRefs":["repo://abiogenesis/specification/requirements/product/REQ-P-SELF-CONFORMANCE.md","repo://abiogenesis/specification/requirements/product/REQ-P-QUAL.md","file:///Users/jim/src/apps/abiogenesis/build_tenants/abiogenesis/typescript/code/src/abg/qualification_proof.ts","file:///Users/jim/src/apps/abiogenesis/build_tenants/abiogenesis/typescript/code/src/validator/qualification.ts","file:///Users/jim/src/apps/abiogenesis/build_tenants/abiogenesis/typescript/code/src/validator/self_conformance.ts","file:///Users/jim/src/apps/abiogenesis/build_tenants/abiogenesis/typescript/design/T287_F11_REUSABLE_QUALIFICATION_LIBRARY_TARGET_DESIGN.md","file:///Users/jim/src/apps/abiogenesis/build_tenants/abiogenesis/typescript/design/T287_D4_D5_NATIVE_QUALIFICATION_DESIGN.md","file:///Users/jim/src/apps/abiogenesis/build_tenants/abiogenesis/typescript/design/T287_F11_CARRIER_RESOURCE_DESIGN.md","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/work/T287_REFERENCE_ATTRIBUTION_REPAIR_01/grant.md","file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_CONTEXT_CONSERVATION_02/acceptance.json"],"surfaceRef":"file:///Users/jim/src/apps/abiogenesis/build_tenants/abiogenesis/typescript/code/src/abg/qualification_proof.ts"}],"kind":"qualification_raw_judgment","residuals":["The inventory is declared incomplete (two Source members only). Whole-candidate coverage, the seven seeded defects, QUAL-056 verification, RC publication, installed qualification and owner acceptance are still open.","The assessor did not recompute SHA-256 digests or the delta hunk line positions. Correspondence was checked through byte-count arithmetic (82284+12=82296; 63360+124=63484; 63484-72=63412), comparison of delta text against the supplied preimage and current bodies, and agreement between the grant digests and the activation records.","Authority correspondence: the records name each file grant, issued by Root under the owner's 'start', as the authority. product-owner@5 is the qualification policy authority slot that grant04 maps to, with no retroauthorization. Establishing it relies on the trusted-developer-desktop boundary (REQ-P-QUAL-065).","Chain 1 selects proof.ts only from a historical two-file activation/delta/closure. The two-file historical scope is retained, not rewritten. The closure's qualification.ts entry (8f929, 63484B) is an intermediate postimage that chain 2 uses as its preimage.","The criterion is falsified because the plan-level all-or-nothing early return in resolveQualificationAssessments still drops every authenticated judgment and its failure citations when any declared slot is missing or refused."],"schemaVersion":"5.0.0"},"schemaVersion":"5.0.0","source":{"actorInvocationRef":"actor-invocation://abiogenesis/77425388daca516da7d760dfa20a0ab6b648cf7bc866454a2dad58c7ae12a019","actorRef":"actor://abiogenesis/qualification/assessor-primary@5","cCallRef":"c-call:sha256:0a66704256f37b49766c9b9a04dca3f91f23b13411e6fb07647e5e23a3eb1b4c","inputDigest":"sha256:93a894b2ad5aea2ace9a5206525ef0183ddad491378a6d37fbc0793416b7dea8","observationDigest":"sha256:de02debe950a951a6d97cf94cd1f3ebe9d9a35e318fe11fc098b31201af79e9c","promptDigest":"sha256:347bc1cc48965b4923b43d683dc11914d1cc9eb88218990826a7b3d765c87b27","rawValueDigest":"sha256:a6ead6161332603d3dd2be26ce6b868d2633c5c2e821fdd1c8c5c1ef24ed672c","requestDigest":"sha256:8119ad295760f98334453f403de893e5949f0683a964d6519547dcb4fbbd3e24","transportBindingDigest":"sha256:a28631f017c331289eefd2124206d316b48ad0336d99fffc813cbb670a3225be","transportBindingRef":"transport-binding://abiogenesis/a28631f017c331289eefd2124206d316b48ad0336d99fffc813cbb670a3225be","workerBindingRef":"worker-binding://abiogenesis/qualification/assessor@5"},"task":{"assetSurface":{"authoritySlots":[{"authorityKindRef":"actor-capability://abiogenesis/qualification/product-owner@5","disposition":"normal","fallbackPreconditionRefs":[]}],"constructorRef":"constructor://abiogenesis/t287/genuine-context-assessment-04/supplied-instance","kind":"qualification_assessment","outputContractRefs":["contract://abiogenesis/qualification/assessment-raw@5"],"proofObligationRefs":["proof://abiogenesis/t287/genuine-context-assessment-04/007A-context-attribution-conservation"],"rendererRef":"renderer://abiogenesis/qualification/assessment@5","requiredContexts":["context://abiogenesis/t287/genuine-context-assessment-04"],"standardsRefs":["repo://abiogenesis/specification/requirements/product/REQ-P-SELF-CONFORMANCE.md","repo://abiogenesis/specification/requirements/product/REQ-P-QUAL.md"]},"catalog":{"digest":"sha256:bd58d739d6efddf466d2bee99c95bc0e49ca9ff3de820ec5aab217557f9afa16","ref":"catalog://abiogenesis/qualification/self-conformance@2"},"context":{"contextRef":"context://abiogenesis/t287/genuine-context-assessment-04","inventoryDigest":"sha256:40b7175a20007d363858575e9805f4476c1549a29cfb4c66aeb2969704fad852","members":[{"byteCount":6687,"digest":"sha256:4fa6ea8b7d655a395916b135e333e5f96a5bb309c9166c3e41d14c67d2e21f61","memberRef":"repo://abiogenesis/specification/requirements/product/REQ-P-SELF-CONFORMANCE.md","path":"contracts/qualification/sources/REQ-P-SELF-CONFORMANCE.md"},{"byteCount":35509,"digest":"sha256:9ec53d8053fcae9780ad0d161c0b3fe605523319965b59d5653865254bac1831","memberRef":"repo://abiogenesis/specification/requirements/product/REQ-P-QUAL.md","path":"contracts/qualification/sources/REQ-P-QUAL.md"},{"byteCount":1322,"digest":"sha256:7129e8e5ec2660f6db401fd40f6ca812ccb80d761b64576a4dd51512ba8b2bb6","memberRef":"qualification-inventory://abiogenesis/a215d8ff7281c1bbbc90f66fd4d3affafdb7f0cba7286be848c98a2147af260f","path":"qualification-inventory://abiogenesis/a215d8ff7281c1bbbc90f66fd4d3affafdb7f0cba7286be848c98a2147af260f"},{"byteCount":1076,"digest":"sha256:9c14041ad9523d1cf76a00ee863799532bfe1b61720b9eae0b9322e317534717","memberRef":"file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_REFERENCE_ATTRIBUTION_REPAIR_01/source-construction/activation.json","path":"/Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_REFERENCE_ATTRIBUTION_REPAIR_01/source-construction/activation.json"},{"byteCount":688,"digest":"sha256:85a963c6cb82e2d001582b8060b423fc8e64f962818e4fe31ecb041361086649","memberRef":"file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_REFERENCE_ATTRIBUTION_REPAIR_01/source-construction/preimage.json","path":"/Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_REFERENCE_ATTRIBUTION_REPAIR_01/source-construction/preimage.json"},{"byteCount":2711,"digest":"sha256:d8f1c80f5d4e836ff12d8d8d900d83422eefe24e41a69dbb3b6375b50928d27a","memberRef":"file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_REFERENCE_ATTRIBUTION_REPAIR_01/source-construction/delta.patch","path":"/Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_REFERENCE_ATTRIBUTION_REPAIR_01/source-construction/delta.patch"},{"byteCount":1016,"digest":"sha256:d3566661e6f27ce2864c31eaba18c36a625deba6a0f192cba55abc7c91efd556","memberRef":"file:///Users/jim/src/apps/abiogenesis/.ai-workspace/evidence/T287_REFERENCE_ATTRIBUTION_REPA
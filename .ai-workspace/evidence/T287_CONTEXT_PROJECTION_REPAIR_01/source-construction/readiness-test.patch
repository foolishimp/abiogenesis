+test("ungrouped canonical owners refuse corrupt construction record bytes and attribution spans", () => {
+  const original = embedded(0);
+  const corrupt = structuredClone(original.task);
+  corrupt.provenance.records[0].contentBase64 = Buffer.from("corrupted record").toString("base64");
+  corrupt.provenance.recordSet = coordinate(corrupt.provenance.recordSet.ref, hash(corrupt.provenance.records));
+  const corruptInput = inputFor(identity(corrupt, "taskRef", "taskDigest", "qualification-task://abiogenesis/"));
+  assert.throws(() => prepareQualificationAssessment(corruptInput), /invalid qualification assessment input/);
+  const corruptAssertion = structuredClone(assertion);
+  const record = corruptAssertion.manifests[0].entries.find(entry => entry.entryKind === "material" &&
+    entry.coordinate.ref === original.task.provenance.records[0].ref);
+  record.value.contentBase64 = Buffer.from("corrupted record").toString("base64");
+  corruptAssertion.manifests[0] = identity(corruptAssertion.manifests[0],
+    "resourceRef", "resourceDigest", "qualification-resource://abiogenesis/");
+  assert.throws(() => acquireQualificationResources(corruptAssertion), /qualification_resource_material_bytes/);
+  const badSpan = structuredClone(original.task);
+  badSpan.provenance.chains[0].attributionSources[0].spanDigest = hash("corrupted attribution span");
+  const badSpanInput = inputFor(identity(badSpan, "taskRef", "taskDigest", "qualification-task://abiogenesis/"));
+  assert.throws(() => prepareQualificationAssessment(badSpanInput), /invalid qualification assessment input/);
+  const badEntries = structuredClone(manifest.entries);
+  const provenance = badEntries.find(entry => entry.entryKind === "provenance" &&
+    entry.value.chains[0].activationRef === original.task.provenance.chains[0].activationRef);
+  provenance.value.chains[0].attributionSources[0].spanDigest = hash("corrupted attribution span");
+  provenance.coordinate = coordinate("qualification-provenance://abiogenesis/" + hash(provenance.value).slice(7), hash(provenance.value));
+  const badResource = identity({ ...manifest, entries: badEntries },
+    "resourceRef", "resourceDigest", "qualification-resource://abiogenesis/");
+  const resources = acquireQualificationResources(assertionFor(badResource));
+  assert.throws(() => prepareQualificationAssessment(reference(badSpanInput, badResource), resources),
+    /qualification resource material\/scope correspondence differs/);
+  assert.equal(prepareQualificationAssessment(original).request.inputDigest, hash(original));
+});

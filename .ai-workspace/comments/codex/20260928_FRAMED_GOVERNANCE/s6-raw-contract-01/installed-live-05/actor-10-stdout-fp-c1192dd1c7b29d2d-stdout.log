rld.mjs\", \"planField\": \"cliCheck\" },\n    { \"ordinal\": 1, \"commandId\": \"command://default-library-witness/1@5\", \"line\": \"node --test test/component/hello-cli.test.mjs test/uat/hello-cli.uat.test.mjs\", \"planField\": \"command/args\" }\n  ],\n  \"acceptance\": {\n    \"rule\": \"command exited 0 AND observedTestPassCount >= expectedTestPassCount AND planSatisfied\",\n    \"observedTestPassCount\": \"integer N from the recorded runner summary line 'pass N' (spec 'ℹ pass N' or TAP '# pass N')\",\n    \"planSatisfied\": [\n      \"recorded test-command stdout contains expectedStdoutMatch\",\n      \"recorded fail count equals expectedFailCount (0)\",\n      \"every requiredPassingTests name is reported as passing ('✔ <name>' or 'ok N - <name>')\",\n      \"cliCheck recorded exitStatus is 0 and stdout equals expectedStdout exactly\",\n      \"cliCheck recorded stdout without its single trailing '\\\\n' equals assertedReturnValue\",\n      \"evidence binds the current digests of generated/hello-world.mjs and both test files; test digests equal the basis below\"\n    ]\n  },\n  \"evidence\": {\n    \"carrier\": \"admitted command-execution (C2) observations from an actual run of both fixed commands on the current subject\",\n    \"mustRecord\": [\"command\", \"args\", \"integer exit status\", \"signal\", \"timedOut\", \"stdout (text, byteLength, digest)\", \"stderr (text, byteLength, digest)\", \"cwd\", \"env\", \"input file digests\", \"resulting test observations (tests, pass, fail, test names)\"],\n    \"planValuesCompared\": [\"expectedTestPassCount\", \"expectedStdoutMatch\", \"assertedReturnValue\"],\n    \"notEvidence\": [\"a handwritten test-execution-result.json\", \"a fabricated success file\", \"an author's report or local run\"],\n    \"planRole\": \"declares expectations that must agree with the fixed commands; it is not the runtime source of the commands\"\n  },\n  \"basis\": {\n    \"source/original-basic-cli.txt\": \"sha256:ce602ce2cc0fcefaba
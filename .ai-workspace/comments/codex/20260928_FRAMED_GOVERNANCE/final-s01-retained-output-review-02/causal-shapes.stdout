REPLAY_CONTEXT "1950:  }\n1951:  return fluentRef;\n1952:}\n1953:\n1954:/**\n1955: * Projects one Run as a single replay-owned semantic relation view. Runtime\n1956: * carriers remain immutable physical truth; only closed typed event-reference\n1957: * paths become positional relation edges. Product-owned JSON is never walked.\n1958: * An existing held coordinate only reidentifies historical source cuts; raw or\n1959: * closed-owner callers retain the same complete cold authentication.\n1960: */\n1961:export function projectRunSemanticReplayProjection(\n1962:  fullPrefix: ValidatedRuntimeEventPrefix,\n1963:  runId: string,\n1964:  currentOwnerPrefix?: DurablePrefixCoordinate,\n1965:): RunSemanticRelationView {\n1966:  return projectRunSemanticReplay(fullPrefix, runId, undefined, currentOwnerPrefix);\n1967:}\n1968:\n1969:/** One replay-owned derivation for the read owner's joined projections. */\n1970:export function projectRunReplayContext(\n1971:  fullPrefix: ValidatedRuntimeEventPrefix,\n1972:  runId: string,\n1973:  currentOwnerPrefix?: DurablePrefixCoordinate,\n1974:) {\n1975:  const prefix = selectValidatedRuntimeEventPrefix(runtimeEventsFromValidatedPrefix(fullPrefix), { runId });\n1976:  const replay = replayValidatedRuntimeEventPrefix(prefix, fullPrefix);\n1977:  if (replay.runId !== runId) return null;\n1978:  const context = { prefix, replay, calculus: deriveRuntimeEventCalculusProjection(prefix) };\n1979:  return deepFreeze({ ...context, semanticReplay: projectRunSemanticReplay(fullPrefix, runId, context, currentOwnerPrefix) });\n1980:}\n1981:\n1982:function projectRunSemanticReplay(\n1983:  fullPrefix: ValidatedRuntimeEventPrefix,\n1984:  runId: string,\n1985:  context?: Readonly<{\n1986:    prefix: ValidatedRuntimeEventPrefix;\n1987:    replay: ReplayState;\n1988:    calculus: RuntimeEventCalculusProjection;\n1989:  }>,\n1990:  currentOwnerPrefix?: DurablePrefixCoordinate,\n1991:): RunSemanticRelationView {\n1992:  if (runId.length === 0) {\n1993:    throw new TypeError(\"run semantic relation requires one non-empty Run id\");\n1994:  }\n1995:  const fullEvents = runtimeEventsFromValidatedPrefix(fullPrefix);\n1996:  const runPrefix = context?.prefix ?? selectValidatedRuntimeEventPrefix(fullEvents, { runId });\n1997:  const events = runtimeEventsFromValidatedPrefix(runPrefix);\n1998:  if (\n1999:    events.length === 0 ||\n2000:    !events.some((event) => event.runId === runId) ||\n2001:    events.some((event) => event.runId !== undefined && event.runId !== runId)\n2002:  ) {\n2003:    throw new TypeError(\n2004:      \"run semantic relation requires one exact causally closed Run prefix\",\n2005:    );\n2006:  }\n2007:  const correspondence = new Map(\n2008:    events.map((event, index) => [event.eventId, `r${index + 1}`]),\n2009:  );\n2010:  if (correspondence.size !== events.length) {\n2011:    throw new TypeError(\"run semantic relation requires unique event identities\");\n2012:  }\n2013:  const fullEventIds = new Set(fullEvents.map((event) => event.eventId));\n2014:  const replayState = context?.replay ?? replayValidatedRuntimeEventPrefix(runPrefix, fullPrefix);\n2015:  if (replayState.runId !== runId) {"
DECODER_FINAL "3216:    if (profile === null) profile = eventContractDigest === undefined\n3217:      ? LEGACY_ROOT_EVENT_CONTRACT_DIGEST : ROOT_EVENT_CONTRACT_DIGEST;\n3218:    if ((profile === LEGACY_ROOT_EVENT_CONTRACT_DIGEST && eventContractDigest !== undefined) ||\n3219:        (profile === ROOT_EVENT_CONTRACT_DIGEST && eventContractDigest !== ROOT_EVENT_CONTRACT_DIGEST)) {\n3220:      throw new TypeError(\"event stamp differs from the exact native profile schedule\");\n3221:    }\n3222:    const reconstructed = projectRuntimeEventAtContract(\n3223:      admitted,\n3224:      candidateValue as unknown as RuntimeEventCandidate,\n3225:      profile,\n3226:      eventsById,\n3227:      \"decoded\",\n3228:    );\n3229:    // The decoded candidate's fields pass unchanged into reconstruction; only\n3230:    // these stamps and the profile checked above are added. Compare those\n3231:    // fields directly instead of serializing both complete logical events.\n3232:    if (\n3233:      reconstructed.eventId !== eventId ||\n3234:      reconstructed.admissionOrdinal !== admissionOrdinal ||\n3235:      reconstructed.payloadDigest !== payloadDigest\n3236:    ) {\n3237:      throw new TypeError(\n3238:        \"durable ABG event log contains restamped or inconsistent history\",\n3239:      );\n3240:    }\n3241:    if (representation.physicallyInline) {\n3242:      const body = inlineEventBody(reconstructed);\n3243:      if (body !== null) {\n3244:        inlineByEvent.set(reconstructed.eventId, body);\n3245:        if (!inlineBodies.has(body.digest)) inlineBodies.set(body.digest, body);\n3246:      }\n3247:    }\n3248:    physicalHash.update(line + \"\\n\"); byteLength += Buffer.byteLength(line + \"\\n\");\n3249:    physicalRows.push([reconstructed, { source: physicalSource, previous: admitted.at(-1) ?? null, byteLength,\n3250:      digest: `sha256:${physicalHash.copy().digest(\"hex\")}` as Sha256Digest }]);\n3251:    admitted.push(reconstructed);\n3252:    if (isRootEventProfileBoundary(reconstructed)) {\n3253:      assertRootEventProfileBoundary(admitted.slice(0, -1), reconstructed);\n3254:      if (profile !== LEGACY_ROOT_EVENT_CONTRACT_DIGEST) throw new TypeError(\"native profile boundary cannot repeat or reverse\");\n3255:      profile = ROOT_EVENT_CONTRACT_DIGEST;\n3256:    }\n3257:    eventsById.set(reconstructed.eventId, reconstructed);\n3258:  }\n3259:  if (expectedProfileDigest !== undefined &&\n3260:      (!isKnownRootEventContractDigest(expectedProfileDigest) || (profile !== null && profile !== expectedProfileDigest))) {\n3261:    throw new TypeError(\"durable coordinate profile differs from authenticated history\");\n3262:  }\n3263:  for (const [event, receipt] of physicalRows) physicalEventPrefixes.set(event, receipt);\n3264:  return { events: Object.freeze(admitted), eventsById, inlineBodies, physicalSource };\n3265:}"

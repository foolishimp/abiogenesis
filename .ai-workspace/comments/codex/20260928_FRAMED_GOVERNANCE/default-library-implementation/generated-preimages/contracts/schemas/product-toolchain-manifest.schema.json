{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abg.schema.product-toolchain-manifest@5",
  "title": "ABIogenesis Product Toolchain Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "productId",
    "packageName",
    "packageVersion",
    "productContentDigest",
    "productRelativeLocators",
    "descriptorRef",
    "publisherNamespace",
    "contributionManifestRef",
    "contributionManifestDigest",
    "contributionManifest",
    "compatibilityRefs",
    "declaredDependencies",
    "provenanceRef",
    "declaredCapabilityRefs",
    "capabilityDefinitionGraph",
    "publicContractCatalog"
  ],
  "properties": {
    "kind": {
      "const": "abg_product_toolchain_manifest"
    },
    "schemaVersion": {
      "const": "5.0.0"
    },
    "productId": {
      "type": "string",
      "minLength": 1
    },
    "packageName": {
      "type": "string",
      "minLength": 1
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "productContentDigest": {
      "$ref": "#/$defs/sha256"
    },
    "productRelativeLocators": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "descriptorRef": {
      "$ref": "#/$defs/ref"
    },
    "publisherNamespace": {
      "$ref": "#/$defs/ref"
    },
    "contributionManifestRef": {
      "$ref": "#/$defs/ref"
    },
    "contributionManifestDigest": {
      "$ref": "#/$defs/sha256"
    },
    "contributionManifest": {
      "$ref": "#/$defs/contributionManifest"
    },
    "compatibilityRefs": {
      "$ref": "#/$defs/refs"
    },
    "declaredDependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "provenanceRef": {
      "$ref": "#/$defs/ref"
    },
    "declaredCapabilityRefs": {
      "$ref": "#/$defs/refs"
    },
    "capabilityDefinitionGraph": {
      "$ref": "#/$defs/capabilityDefinitionGraphManifestCoordinate"
    },
    "publicContractCatalog": {
      "type": "object"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ref": {
      "type": "string",
      "pattern": "\\S"
    },
    "refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "productId",
        "packageVersion",
        "compatibilityRef",
        "requiredContractRefs",
        "requiredCapabilityRefs"
      ],
      "properties": {
        "kind": {
          "const": "requires"
        },
        "productId": {
          "$ref": "#/$defs/ref"
        },
        "packageVersion": {
          "$ref": "#/$defs/ref"
        },
        "compatibilityRef": {
          "$ref": "#/$defs/ref"
        },
        "requiredContractRefs": {
          "$ref": "#/$defs/refs"
        },
        "requiredCapabilityRefs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "contributionManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "contributionManifestRef",
        "productId",
        "productVersion",
        "descriptorRef",
        "productContentDigest",
        "publicContractCatalogId",
        "publicContractCatalogDigest",
        "capabilityDefinitionGraph",
        "publicationBindings",
        "rows"
      ],
      "properties": {
        "kind": {
          "const": "product_contribution_manifest"
        },
        "schemaVersion": {
          "const": "5.0.0"
        },
        "contributionManifestRef": {
          "$ref": "#/$defs/ref"
        },
        "productId": {
          "$ref": "#/$defs/ref"
        },
        "productVersion": {
          "$ref": "#/$defs/ref"
        },
        "descriptorRef": {
          "$ref": "#/$defs/ref"
        },
        "productContentDigest": {
          "$ref": "#/$defs/sha256"
        },
        "publicContractCatalogId": {
          "$ref": "#/$defs/ref"
        },
        "publicContractCatalogDigest": {
          "$ref": "#/$defs/sha256"
        },
        "capabilityDefinitionGraph": {
          "$ref": "#/$defs/capabilityDefinitionGraphCoordinate"
        },
        "publicationBindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/publicationBinding"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contributionRow"
          }
        }
      }
    },
    "capabilityDefinitionGraphCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphId", "graphVersion", "graphDigest"],
      "properties": {
        "graphId": {
          "const": "capability-definition-graph://abiogenesis/abg-5"
        },
        "graphVersion": {
          "const": "5.0.0"
        },
        "graphDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "capabilityDefinitionGraphManifestCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphId", "graphVersion", "graphDigest", "assetLocator"],
      "properties": {
        "graphId": {
          "const": "capability-definition-graph://abiogenesis/abg-5"
        },
        "graphVersion": {
          "const": "5.0.0"
        },
        "graphDigest": {
          "$ref": "#/$defs/sha256"
        },
        "assetLocator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "mediaType", "schemaVersion", "contentDigest"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "mediaType": { "const": "application/json" },
            "schemaVersion": { "const": "5.0.0" },
            "contentDigest": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "publicationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleRef",
        "publicationDigest"
      ],
      "properties": {
        "moduleRef": {
          "$ref": "#/$defs/ref"
        },
        "publicationDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "contributionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleRef",
        "handle",
        "kind",
        "declarationOrContractRef",
        "owningProductId",
        "programMembershipRefs",
        "compatibilityRefs",
        "provenanceRef",
        "readinessPrerequisiteRefs"
      ],
      "properties": {
        "moduleRef": {
          "$ref": "#/$defs/ref"
        },
        "handle": {
          "$ref": "#/$defs/ref"
        },
        "kind": {
          "enum": [
            "graph_function",
            "node_type",
            "overlay"
          ]
        },
        "declarationOrContractRef": {
          "$ref": "#/$defs/ref"
        },
        "owningProductId": {
          "$ref": "#/$defs/ref"
        },
        "programMembershipRefs": {
          "$ref": "#/$defs/refs"
        },
        "compatibilityRefs": {
          "$ref": "#/$defs/refs"
        },
        "provenanceRef": {
          "$ref": "#/$defs/ref"
        },
        "readinessPrerequisiteRefs": {
          "$ref": "#/$defs/refs"
        }
      }
    }
  }
}

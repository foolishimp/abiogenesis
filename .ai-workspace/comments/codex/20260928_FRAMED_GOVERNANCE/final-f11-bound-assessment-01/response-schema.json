{
  "type": "object",
  "properties": {
    "kind": {
      "const": "qualification_raw_judgment"
    },
    "schemaVersion": {
      "const": "5.0.0"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterionRef": {
            "type": "string",
            "minLength": 1
          },
          "ruleRef": {
            "type": "string",
            "minLength": 1
          },
          "surfaceRef": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRole": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "satisfied",
              "falsified",
              "indeterminate"
            ],
            "type": "string"
          },
          "applicability": {
            "enum": [
              "applicable",
              "inapplicable",
              "unknown"
            ],
            "type": "string"
          },
          "grouping": {
            "enum": [
              "justified",
              "falsified",
              "unknown"
            ],
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "residuals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "criterionRef",
          "ruleRef",
          "surfaceRef",
          "evidenceRole",
          "disposition",
          "applicability",
          "reason",
          "sourceRefs",
          "evidenceRefs",
          "residuals",
          "grouping"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "residuals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "attributions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "activationRef": {
            "type": "string",
            "minLength": 1
          },
          "authorRef": {
            "type": "string",
            "minLength": 1
          },
          "actorIdentityRef": {
            "type": "string",
            "minLength": 1
          },
          "authorityRef": {
            "type": "string",
            "minLength": 1
          },
          "scopeRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "disposition": {
            "enum": [
              "established",
              "disputed",
              "insufficient"
            ],
            "type": "string"
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "activationRef",
          "authorRef",
          "actorIdentityRef",
          "authorityRef",
          "scopeRefs",
          "disposition",
          "sourceRefs",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "criteria",
    "residuals",
    "attributions"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

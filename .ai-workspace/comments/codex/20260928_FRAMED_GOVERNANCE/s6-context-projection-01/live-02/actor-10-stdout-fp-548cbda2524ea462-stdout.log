],\n\n  \"command\": \"node\",\n  \"args\": [\"--test\", \"test/component/hello-cli.test.mjs\", \"test/uat/hello-cli.uat.test.mjs\"],\n  \"cwd\": \".\",\n  \"expectedExitStatus\": 0,\n  \"expectedTestPassCount\": 2,\n  \"expectedStdoutMatch\": \"fail 0\",\n  \"assertedReturnValue\": \"Hello, world!\",\n\n  \"declaredCommands\": [\n    {\n      \"id\": \"cli\",\n      \"witnessSelection\": 1,\n      \"purpose\": \"Execution proof: run the CLI and observe stdout exactly \\\"Hello, world!\\\\n\\\" (OS:L13, OS:L34); carrier of assertedReturnValue (OS:L76). TD CHK-CLI-1.\",\n      \"command\": \"node\",\n      \"args\": [\"generated/hello-world.mjs\"],\n      \"cwd\": \".\",\n      \"expected\": {\n        \"exitStatus\": 0,\n        \"timedOut\": false,\n        \"processSignal\": null,\n        \"stdout\": \"Hello, world!\\n\",\n        \"stdoutByteLength\": 14,\n        \"stdoutHex\": \"48656c6c6f2c20776f726c64210a\",\n        \"stdoutSha256\": \"d9014c4624844aa5bac314773d6b689ad467fa4e1d1a50a1b8a99d5a95f72ff5\",\n        \"stdoutEquals\": \"assertedReturnValue + \\\"\\\\n\\\"\"\n      }\n    },\n    {\n      \"id\": \"tests\",\n      \"witnessSelection\": 2,\n      \"purpose\": \"Run the component and UAT verifiers against the current CLI (OS:L72-73). TD TC-COMP-1 and TC-UAT-1.\",\n      \"command\": \"node\",\n      \"args\": [\"--test\", \"test/component/hello-cli.test.mjs\", \"test/uat/hello-cli.uat.test.mjs\"],\n      \"cwd\": \".\",\n      \"expected\": {\n        \"exitStatus\": 0,\n        \"timedOut\": false,\n        \"processSignal\": null,\n        \"minimumPassCount\": 2,\n        \"failCount\": 0,\n        \"stdoutMatch\": \"fail 0\",\n        \"requiredPassingTests\": [\n          {\n            \"role\": \"component\",\n            \"file\": \"test/component/hello-cli.test.mjs\",\n            \"sha256\": \"8b55bf3f6324da565a1de9a5186444e36c43f450484463aafc84b65fd9da4613\",\n            \"name\": \"CLI process satisfies its output contract\"\n          },\n          {\n            \"role\": \"uat\",\n            \"file\": \"test/uat/hello-cli.uat.test.mjs\",\n            \"sha256\": \"5449c227c7173bb1b812e46e06d3341b1624e832a2a74105f9a109ee201134d4\",\n            \"name\": \"a user receives the exact promised greeting\"\n          }\n        ]\n      }\n    }\n  ],\n\n  \"coverage\": {\n    \"floor\": \"expectedTestPassCount = 2: one component test plus one UAT test (OS:L74, OR:minimumTestPasses). The exact pass count is not pinned, so added depth tests remain admissible (OS:L75).\",\n    \"pairing\": \"Both requiredPassingTests must be reported passing by name in the same admitted run of command 'tests'. Exit 0 alone, UAT alone, or an aggregate count without both names is insufficient (PC R-12, WC:L78-79).\"\n  },\n\n  \"observedResultCriteria\": {\n    \"observationSource\": \"Admitted C2 command-execution observations (contract://abiogenesis/worksite/command-execution-observation@5) of declaredCommands 'cli' and 'tests', whose recorded files carry the same current generated/hello-world.mjs digest and the requiredPassingTests source digests.\",\n    \"observedFields\": [\"executable\", \"args\", \"environment\", \"relativeCwd\", \"exitStatus\", \"timedOut\", \"processSignal\", \"stdout\", \"stderr\", \"files\"],\n    \"planFields\": [\"expectedTestPassCount\", \"expectedStdoutMatch\", \"assertedReturnValue\"],\n    \"observedTestPassCount\": \"Integer N from the 'tests' stdout summary line matching /^(?:ℹ|#) pass (\\\\d+)$/m.\",\n    \"observedTestFailCount\": \"Integer N from the 'tests' stdout summary line matching /^(?:ℹ|#) fail (\\\\d+)$/m.\",\n    \"namedTestPassed\": \"The 'tests' stdout has a line beginning '✔ <name>' (spec) or 'ok <n> - <name>' (TAP), and no line beginning '✖ <name>' or 'not ok <n> - <name>'.\",\n    \"planSatisfied\": [\n      \"tests.exitStatus === 0\",\n      \"observedTestFailCount === 0\",\n      \"tests.stdout includes expectedStdoutMatch\",\n      \"every requiredPassingTests entry satisfies namedTestPassed\",\n      \"cli.exitStatus === 0\",\n      \"cli.stdout === assertedReturnValue + \\\"\\\\n\\\"\",\n      \"neither observation timedOut or has a processSignal\",\n      \"both observations record the same current CLI digest and the requiredPassingTests sha256 values\"\n    ],\n    \"accept\": \"tests.exitStatus === 0 && observedTestPassCount >= expectedTestPassCount && planSatisfied\",\n    \"otherwise\": \"Reject. A failing observation stays as evidence and is never a reason to relax an expectation, edit a test source or change the oracle (PC R-15, WC:L92-94).\",\n    \"evaluator\": \"Independent assessment over admitted evidence (OS:L82-86 test_execution_result produces no files). Not this plan and not its author.\"\n  },\n\n  \"resultCarrier\": {\n    \"originalFile\": \"test-execution-result.json\",\n    \"disposition\": \"Not authored. The original's handwritten execution-result file and worker-run execution (OS:L68-78) are carried by admitted C2 command-execution observations recording the real command, args, cwd, env, integer status, stdout and stderr; expectedTestPassCount, expectedStdoutMatch and assertedReturnValue come from this plan (PC C-1, C-2, R-10; WC:L58-63; OR:assessment).\"\n  },\n\n  \"currentness\": {\n    \"subject\": \"generated/hello-world.mjs as recorded by digest in the admitted observations at execution time. This plan does not pin CLI bytes.\",\n    \"historical\": \"Observations of an earlier CLI digest, including the baseline sha256:647697a5fb5d141a2b1163363170a7a845b61a36096ff52f7a369f1736cd4993 (command 'tests' exit 1, pass 0, fail 2), are retained as revision-lineage counterevidence and can neither satisfy nor refute this plan for the current subject (PC R-13).\",\n    \"invalidatedBy\": [\n      \"a change to either requiredPassingTests source digest\",\n      \"a change to any basis digest\",\n      \"a change to the CLI digest after the admitted observations (the observations become historical; the plan stays valid)\"\n    ]\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}

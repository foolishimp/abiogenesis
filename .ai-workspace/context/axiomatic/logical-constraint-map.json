_type":"constraint","operator":"urn:axiom-indexer:operator:selects","source_refs":["repo://abiogenesis/.ai-workspace/tickets/active/T-287-deliver-abiogenesis-5-feature-waves.md#w3-current-selection","repo://abiogenesis/specification/GOALS.md#current-selection"],"statement":"Current Goals and T-287 own Wave 2 closure and Wave 3 selection. Derived context preserves exact evidence boundaries and does not activate work.","uri":"urn:axiom-indexer:clause:abiogenesis:current-selection-boundary"},{"arguments":[{"ref":"urn:axiom-indexer:symbol:abiogenesis:graph-function","role":"urn:axiom-indexer:role:subject"},{"literal":"effect meaning, topology, inputs, outputs, and refusal relation","role":"urn:axiom-indexer:role:object"}],"clause_type":"constraint","operator":"urn:axiom-indexer:operator:owns","source_refs":["repo://abiogenesis/build_tenants/abiogenesis/typescript/design/ABI5_PROJECT_REFERENCE_FRAME_BASIS.md#f-worksite-causality","repo://abiogenesis/specification/INTENT.md#gtl-owns-program-meaning"],"statement":"GTL and the selected GraphFunction own declared effect meaning; imperative glue does not.","uri":"urn:axiom-indexer:clause:abiogenesis:gtl-declares-effect"},{"arguments":[{"ref":"urn:axiom-indexer:symbol:abiogenesis:hog","role":"urn:axiom-indexer:role:subject"},{"ref":"urn:axiom-indexer:symbol:abiogenesis:execution-basis","role":"urn:axiom-indexer:role:source"},{"literal":"owner effect candidate, evidence, or typed refusal","role":"urn:axiom-indexer:role:target"}],"clause_type":"constraint","operator":"urn:axiom-indexer:operator:derives","source_refs":["repo://abiogenesis/specification/INTENT.md#hog-owns-direct-traversal","repo://abiogenesis/specification/PRODUCT.md#definition-tool-and-runtime-authority"],"statement":"HoG traverses the admitted graph and derives candidates; it does not perform or admit effects.","uri":"urn:axiom-indexer:clause:abiogenesis:hog-derives-candidate"},{"arguments":[{"ref":"urn:axiom-indexer:symbol:abiogenesis:a-c-map","role":"urn:axiom-indexer:role:subject"},{"literal":"constitutional, semantic, execution, admission, event, or release authority","role":"urn:axiom-indexer:role:object"}],"clause_type":"constraint","operator":"urn:axiom-indexer:operator:prohibits","source_refs":["repo://abiogenesis/specification/PRODUCT.md#governance-and-release-boundary"],"statement":"The a_c map compresses attention and routes source re-entry without becoming authority.","uri":"urn:axiom-indexer:clause:abiogenesis:map-is-read-model"},{"arguments":[{"ref":"urn:axiom-indexer:symbol:abiogenesis:effect-owner","role":"urn:axiom-indexer:role:subject"},{"literal":"bounded mutation under exact operation grant, subject, write territory, and handler binding","role":"urn:axiom-indexer:role:object"}],"clause_type":"constraint","operator":"urn:axiom-indexer:operator:performs","source_refs":["repo://abiogenesis/build_tenants/abiogenesis/typescript/design/ABI5_PROJECT_REFERENCE_FRAME_BASIS.md#f-worksite-causality","repo://abiogenesis/specification/PRODUCT.md#definition-tool-and-runtime-authority"],"statement":"The declared owner performs the physical effect or returns its typed refusal.","uri":"urn:axiom-indexer:clause:abiogenesis:owner-performs-effect"},{"arguments":[{"ref":"urn:axiom-indexer:symbol:abiogenesis:replay","role":"urn:axiom-indexer:role:subject"},{"ref":"urn:axiom-indexer:symbol:abiogenesis:abg","role":"urn:axiom-indexer:role:evidence"},{"ref":"urn:axiom-indexer:symbol:abiogenesis:observation-snapshot","role":"urn:axiom-indexer:role:target"}],"clause_type":"constraint","operator":"urn:axiom-indexer:operator:derives","source_refs":["repo://abiogenesis/build_tenants/abiogenesis/typescript/design/ABI5_PROJECT_REFERENCE_FRAME_BASIS.md#f-worksite-causality","repo://abiogenesis/build_tenants/abiogenesis/typescript/design/T287_W2_R3_C0_MUTABLE_WORKSITE_CAUSALITY_DESIGN.md#existing-event-and-replay-treatment","repo://abiogenesis/build_tenants/abiogenesis/typescript/design/T287_W2_R3_C0_MUTABLE_WORKSITE_CAUSALITY_DESIGN.md#sequence-and-state-treatment","repo://abiogenesis/specification/INTENT.md#abg-owns-admitted-runtime-truth"],"statement":"Fresh replay derives admitted observation currentness: complete C0 success replaces O0 with exact O1; an authenticated admitted post-publication failure terminates O0 and initiates no successor, even with a retained receipt or successful compensation. After that failure, another attempt requires fresh observation and authorization.","uri":"urn:axiom-indexer:clause:abiogenesis:replay-derives-current-observation"},{"arguments":[{"literal":"a material effect has changed the worksite","role":"urn:axiom-indexer:role:condition"},{"literal":"dependent traversal using the predecessor observation as current truth","role":"urn:axiom-indexer:role:object"}],"clause_type":"constraint","operator":"urn:axiom-indexer:operator:prohibits","source_refs":["repo://abiogenesis/build_tenants/abiogenesis/typescript/design/ABI5_PROJECT_REFERENCE_FRAME_BASIS.md#f-worksite-causality","repo://abiogenesis/build_tenants/abiogenesis/typescript/design/T287_W2_ODD_GLC_TYPED_WORKSPACE_ADMISSION_DESIGN.md#mandatory-falsifiers"],"statement":"A stale observation cannot cross the next dependent graph boundary.","uri":"urn:axiom-indexer:clause:abiogenesis:stale-observation-refuses"},{"arguments":[{"ref":"urn:axiom-indexer:symbol:abiogenesis:worksite","role":"urn:axiom-indexer:role:subject"},{"literal":"physical mutation without required ABG admission, including owner publication followed by refused evidence/result admission or append","role":"urn:axiom-indexer:role:condition"},{"literal":"runtime truth","role":"urn:axiom-indexer:role:target"}],"clause_type":"constraint","operator":"urn:axiom-indexer:operator:prohibits","source_refs":["repo://abiogenesis/build_tenants/abiogenesis/typescript/design/ABI5_PROJECT_REFERENCE_FRAME_BASIS.md#f-worksite-causality","repo://abiogenesis/build_tenants/abiogenesis/typescript/design/T287_W2_R3_C0_MUTABLE_WORKSITE_CAUSALITY_DESIGN.md#sequence-and-stat
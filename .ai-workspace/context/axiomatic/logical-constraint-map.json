{"calculus_ref":"stdo://releases/v2.5.0-rc.6/standards/AXIOMATIC_CALCULUS.md","clauses":[{"arguments":[{"ref":"urn:axiom-indexer:symbol:abiogenesis:abg","role":"urn:axiom-indexer:role:subject"},{"literal":"causal effect, evidence, outcome, continuation, and closure truth","role":"urn:axiom-indexer:role:object"}],"clause_type":"constraint","operator":"urn:axiom-indexer:operator:admits","source_refs":["repo://abiogenesis/specification/INTENT.md#abg-owns-admitted-runtime-truth","repo://abiogenesis/specification/PRODUCT.md#definition-tool-and-runtime-authority"],"statement":"ABG alone admits the causal runtime facts required by the declared effect path.","uri":"urn:axiom-indexer:clause:abiogenesis:abg-admits-causal-truth"},{"arguments":[{"literal":"WorkspaceAuthorityBasis, ProductSet, resolved lock, or declared root changes","role":"urn:axiom-indexer:role:condition"},{"literal":"new WorkspaceBinding and owning re-entry","role":"urn:axiom-indexer:role:requirement"}],"clause_type":"constraint","operator":"urn:axiom-indexer:operator:requires","source_refs":["repo://abiogenesis/build_tenants/abiogenesis/typescript/design/ABI5_PROJECT_REFERENCE_FRAME_BASIS.md#f-worksite-causality"],"statement":"A changed binding constituent requires a new binding and its owning re-entry.","uri":"urn:axiom-indexer:clause:abiogenesis:binding-constituent-change-reenters"},{"arguments":[{"ref":"urn:axiom-indexer:symbol:abiogenesis:worksite","role":"urn:axiom-indexer:role:subject"},{"literal":"Full admitted WorkspaceAuthorityBasis A addresses authored work beneath A.canonicalRoot; WorkspaceBinding W retains the immutable Product owner at W.roots.productRoot and installed helper beneath W.roots.toolchainRoot.","role":"urn:axiom-indexer:role:object"}],"clause_type":"constraint","operator":"urn:axiom-indexer:operator:distinguishes","source_refs":["repo://abiogenesis/build_tenants/abiogenesis/typescript/design/T287_W2_R3_C2_WORKSITE_COMMAND_EXECUTION_DESIGN.md#exact-worksite-root-authority"],"stateme
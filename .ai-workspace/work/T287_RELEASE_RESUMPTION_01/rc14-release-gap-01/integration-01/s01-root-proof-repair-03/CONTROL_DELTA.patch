+async function observeTopology(boundary,layout){
+  const input=Buffer.from(JSON.stringify(layout));
+  const command='/usr/bin/python3',args=[join(dir,'physical-topology.py'),'-'];
+  const execution=await new Promise(resolve=>{
+    let inputError=null;
+    const child=execFile(command,args,{timeout:60000,maxBuffer:4*1024*1024,encoding:'buffer'},
+      (error,stdout,stderr)=>resolve({error,inputError,stdout,stderr,status:child.exitCode,signal:child.signalCode}));
+    child.stdin.on('error',error=>{inputError=error;});
+    child.stdin.end(input);
+  });
+  const errorFacts=error=>error===null?null:{name:error.name,message:error.message,stack:error.stack,
+    code:error.code??null,errno:error.errno??null,signal:error.signal??null,killed:error.killed??null};
+  const captures=[
+    ['input.raw',input,true],
+    ['stdout.raw',execution.stdout,true],
+    ['stderr.raw',execution.stderr,true],
+    ['execution.json',{command,args,status:execution.status,signal:execution.signal,
+      error:errorFacts(execution.error),inputError:errorFacts(execution.inputError)},false]
+  ];
+  const captureFailures=[];
+  for(const [name,value,rawBytes] of captures){
+    try{await record(`topology-observations/${boundary}/${name}`,value,rawBytes);}
+    catch(error){captureFailures.push({name,error});}
+  }
+  let primary=execution.error??execution.inputError,result;
+  if(primary===null){
+    try{
+      result=JSON.parse(execution.stdout.toString('utf8'));
+      assert.equal(result.ok,true,result.reason);
+      assert.equal(result.disposition,'separated',result.reason);
+    }catch(error){primary=error;}
+  }
+  if(captureFailures.length){
+    const failures=captureFailures.map(({name,error})=>({name,error:errorFacts(error)}));
+    // The host's original stderr is independently retained by operate.py. A
+    // failed evidence write must not erase a child/parse/assertion Error.
+    try{process.stderr.write(JSON.stringify({kind:'topology_capture_failures',boundary,failures})+'\n');}
+    catch(error){failures.push({name:'host-stderr',error:errorFacts(error)});}
+    try{await record(`topology-observations/${boundary}/capture-failures.json`,{failures});}
+    catch(error){try{process.stderr.write(JSON.stringify({kind:'topology_capture_failure_record_error',boundary,error:errorFacts(error)})+'\n');}catch{}}
+  }
+  if(primary!==null)throw primary;
+  if(captureFailures.length)throw captureFailures[0].error;
+  return result;
+}

+// S06 assessment dependency (native HOW, Declared typed assessment; common HOW
+// installed split proof obligation). The core semantic-stage publication is the
+// unique owner of the native-assessment contract and the core install holds its
+// schema asset; the executing consumer Program owns no contract and its own
+// local start member declares use. One case-local packed install (the shared
+// libraryInstall is untouched), one actual Public start that dispatches the
+// assessor once through the generic default-library run environment, then the
+// leaf port, the shared relation, the persisted assembly basis, cold assembly,
+// the warm/cold raw preimage and both fresh Public readbacks of that same Run.
+// The scripted stand-in output satisfies the actual installed schema; it proves
+// mechanics only. Every observation is captured before the check that reads it.
+const S06_CORE_ASSESSMENT_REF='contract://abiogenesis/semantic-stage/native-assessment@5';
+function s06SplitConsumerDeclaration(g,library,runEnvironment,useContractRef){
+  // The coincident witness consumer, except that it owns no contract and its
+  // local executive member declares use of the core contract.
+  const coincident=libraryConsumerDeclaration(g,library,runEnvironment),owned=witnessRef('contract','assessment');
+  const graphFunctions=coincident.graphFunctions.map(graph=>graph.declarations['abg.raw_result_contract']!==owned?graph:
+    {...graph,declarations:{...graph.declarations,'abg.raw_result_contract':useContractRef}});
+  assert.equal(graphFunctions.filter(graph=>graph.declarations['abg.raw_result_contract']===useContractRef).length,1,'one local executive member declares use');
+  return {...coincident,contracts:[],graphFunctions};
+}
+// The existing scripted actor with two declared seams: an explicit gap at the
+// selection after the one UAT selection, and the assessor answering with a
+// supplied schema-valid value. Each seam must occur exactly once.
+const S06_ACTOR_SEAMS=[
+  [`gap=process.env.ABI5_SCRIPTED_ACTOR_PHASE==='gap-after-construction'&&domain.length>0;`,
+    `gap=process.env.ABI5_SCRIPTED_ACTOR_PHASE==='gap-after-construction'&&domain.length>0||process.env.ABI5_SCRIPTED_ACTOR_PHASE==='gap-after-assessment'&&prior.some(r=>r.role==='select:'+uat);`],
+  [`output={kind,disposition:'satisfied',reason:'Scripted assessment.',unresolvedCriteria:[]};}`,
+    `output=process.env.ABI5_SCRIPTED_ASSESSMENT_OUTPUT?JSON.parse(readFileSync(process.env.ABI5_SCRIPTED_ASSESSMENT_OUTPUT,'utf8')):{kind,disposition:'satisfied',reason:'Scripted assessment.',unresolvedCriteria:[]};}`]];
+function s06ScriptedActor(){
+  let source=SCRIPTED_ACTOR;
+  for(const [from,to] of S06_ACTOR_SEAMS){assert.equal(source.split(from).length,2,'one exact scripted-actor seam: '+from);source=source.replace(from,()=>to);}
+  return source;
+}

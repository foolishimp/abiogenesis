+const fail=m=>{process.stderr.write('s06 scripted actor: '+m+'\\n');process.exit(1);};
+// One delivered JSON value after its label, either raw or JSON-string escaped.
+const valueAt=s=>{const open=prompt[s],close=open==='{'?'}':open==='['?']':null;if(close===null)return undefined;
+ let depth=0;for(let k=s;k<prompt.length;k++){const ch=prompt[k];if(ch===open)depth++;else if(ch===close&&--depth===0){const raw=prompt.slice(s,k+1);
+  try{return JSON.parse(raw);}catch{try{return JSON.parse(JSON.parse('"'+raw+'"'));}catch{return undefined;}}}}return undefined;};
+const after=label=>{for(let i=prompt.indexOf(label);i>=0;i=prompt.indexOf(label,i+1)){const value=valueAt(i+label.length);if(value!==undefined)return value;}return undefined;};
+const schema=at>=0?JSON.parse(args[at+1]):{},props=schema.properties??{},author='summary' in props&&'gaps' in props;
+const members=after('Source identities and roles: ');
+const member=Array.isArray(members)?members.find(m=>m&&typeof m.memberRef==='string'&&typeof m.path==='string'):undefined;
+let quote=null;if(member!==undefined)try{const line=readFileSync(member.path,'utf8').split('\\n').map(l=>l.trim()).find(l=>l.length>0);if(line!==undefined)quote={memberRef:member.memberRef,quote:line};}catch{}

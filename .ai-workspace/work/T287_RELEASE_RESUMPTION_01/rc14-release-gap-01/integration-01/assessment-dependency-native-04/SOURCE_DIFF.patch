+ if(Array.isArray(s.anyOf))return pick(s.anyOf.find(x=>x&&x.type==='null')??s.anyOf[0],name);
+ const type=Array.isArray(s.type)?(s.type.includes('null')?'null':s.type[0]):s.type;

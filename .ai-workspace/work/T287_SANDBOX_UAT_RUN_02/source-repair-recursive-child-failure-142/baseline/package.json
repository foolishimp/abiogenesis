{
  "name": "@abiogenesis/typescript-tenant",
  "version": "5.0.0-rc.1",
  "description": "ABIogenesis 5 direct-GTL TypeScript product",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.5.1",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "abg.cli": "./build/code/src/public/cli.js",
    "abg.codex": "./build/code/src/public/codex_cli.js"
  },
  "exports": {
    ".": {
      "types": "./build/code/src/index.d.ts",
      "import": "./build/code/src/index.js"
    },
    "./product": {
      "types": "./build/code/src/product/index.d.ts",
      "import": "./build/code/src/product/index.js"
    },
    "./abg": {
      "types": "./build/code/src/abg/index.d.ts",
      "import": "./build/code/src/abg/index.js"
    },
    "./gtl": {
      "types": "./build/code/src/gtl/index.d.ts",
      "import": "./build/code/src/gtl/index.js"
    },
    "./hog": {
      "types": "./build/code/src/hog/index.d.ts",
      "import": "./build/code/src/hog/index.js"
    },
    "./public": {
      "types": "./build/code/src/public/index.d.ts",
      "import": "./build/code/src/public/index.js"
    },
    "./validator": {
      "types": "./build/code/src/validator/index.d.ts",
      "import": "./build/code/src/validator/index.js"
    },
    "./gtl/m01": {
      "types": "./build/code/src/gtl/m01.d.ts",
      "import": "./build/code/src/gtl/m01.js"
    },
    "./gtl/m02": {
      "types": "./build/code/src/gtl/m02.d.ts",
      "import": "./build/code/src/gtl/m02.js"
    },
    "./gtl/requirements": {
      "types": "./build/code/src/gtl/requirements.d.ts",
      "import": "./build/code/src/gtl/requirements.js"
    },
    "./abg/requirements": {
      "types": "./build/code/src/abg/requirements.d.ts",
      "import": "./build/code/src/abg/requirements.js"
    },
    "./abg/m03": {
      "types": "./build/code/src/abg/m03.d.ts",
      "import": "./build/code/src/abg/m03.js"
    },
    "./abg/m03/transport": {
      "types": "./build/code/src/abg/m03/transport.d.ts",
      "import": "./build/code/src/abg/m03/transport.js"
    },
    "./app/m04": {
      "types": "./build/code/src/app/m04.d.ts",
      "import": "./build/code/src/app/m04.js"
    },
    "./qualification/m05": {
      "types": "./build/code/src/qualification/m05.d.ts",
      "import": "./build/code/src/qualification/m05.js"
    }
  },
  "files": [
    "build/**",
    "contracts/**",
    "product-toolchain-manifest.json"
  ],
  "dependencies": {
    "@valibot/to-json-schema": "1.7.1",
    "effect": "3.22.1",
    "jsonc-parser": "3.3.1",
    "valibot": "1.4.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "bundleDependencies": [
    "@valibot/to-json-schema",
    "effect",
    "jsonc-parser",
    "valibot",
    "ajv",
    "ajv-formats"
  ],
  "scripts": {
    "lint": "node scripts/lint-verification.mjs",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/generate-product-manifest.mjs",
    "prepack": "npm run build",
    "test:r1": "npm run build && node --experimental-vm-modules --test test_env/tests/r1-packed-artifact.test.mjs",
